// LTJBM CDMS — Prisma schema skeleton (Phase A)
// Platform / Auth owns bootstrap; Members / Finance / Reporting extend domain UIs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & access ───────────────────────────────────────────────────────────

enum Role {
  RecordsClerk
  BranchLeader
  FinancialSecretary
  PastoralBoard
  LeadershipCouncil
  Admin
  /// Member self-service portal only — own profile + own giving statement.
  Member
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean           @default(true)
  /// Linked member record for portal users (and optional staff self-link).
  memberId     String?           @unique
  member       Member?           @relation("UserMemberLink", fields: [memberId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  branchScopes UserBranchScope[]
  auditLogs    AuditLog[]        @relation("AuditActor")
  statusChanges MemberStatusHistory[] @relation("StatusChangedBy")
  savedReports SavedReport[]
  followUpsAssigned VisitorFollowUp[] @relation("FollowUpAssignee")
  followUpsCreated  VisitorFollowUp[] @relation("FollowUpCreator")
  pastoralNotes     PastoralCareNote[] @relation("PastoralAuthor")
  attendanceMarked  AttendanceRecord[] @relation("AttendanceMarker")
}

/// Branch / unit scope for Branch Leaders (and similar limited roles).
model UserBranchScope {
  id       String @id @default(cuid())
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ─── Org structure ───────────────────────────────────────────────────────────

model Branch {
  id           String            @id @default(cuid())
  name         String
  code         String            @unique
  country      String
  isHq         Boolean           @default(false)
  isInternational Boolean        @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  cells        Cell[]
  members      Member[]
  userScopes   UserBranchScope[]
  statusFrom   MemberStatusHistory[] @relation("TransferFrom")
  statusTo     MemberStatusHistory[] @relation("TransferTo")
  attendanceSessions AttendanceSession[]
  churchEvents ChurchEvent[]
}

model Cell {
  id         String            @id @default(cuid())
  name       String
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  memberships GroupMembership[]
  attendanceSessions AttendanceSession[]

  @@unique([branchId, name])
}

model FellowshipMinistry {
  id          String            @id @default(cuid())
  name        String            @unique
  code        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships GroupMembership[]
  obligations Obligation[]
}

enum GroupKind {
  Cell
  Fellowship
}

model GroupMembership {
  id                   String              @id @default(cuid())
  memberId             String
  kind                 GroupKind
  cellId               String?
  fellowshipMinistryId String?
  startedAt            DateTime            @default(now())
  endedAt              DateTime?
  member               Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cell                 Cell?               @relation(fields: [cellId], references: [id], onDelete: SetNull)
  fellowshipMinistry   FellowshipMinistry? @relation(fields: [fellowshipMinistryId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([cellId])
  @@index([fellowshipMinistryId])
}

// ─── People ──────────────────────────────────────────────────────────────────

enum MemberStatus {
  Active
  Visitor
  Inactive
  Transferred
  Deceased
  Suspended
}

model Member {
  id               String                @id @default(cuid())
  memberNumber     String?               @unique
  firstName        String
  lastName         String
  otherNames       String?
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  country          String?
  photoKey         String?
  status           MemberStatus          @default(Active)
  /// Church join / reception date (distinct from system createdAt).
  joinedAt         DateTime?
  baptismDate      DateTime?
  confirmationDate DateTime?
  branchId         String
  branch           Branch                @relation(fields: [branchId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  households       HouseholdMember[]
  groups           GroupMembership[]
  statusHistory    MemberStatusHistory[]
  obligations      Obligation[]
  duplicateAsA     DuplicateCandidate[]  @relation("DuplicateA")
  duplicateAsB     DuplicateCandidate[]  @relation("DuplicateB")
  tags             MemberTag[]
  milestones       MemberMilestone[]
  followUps        VisitorFollowUp[]
  attendance       AttendanceRecord[]
  pastoralNotes    PastoralCareNote[]
  portalUser       User?                 @relation("UserMemberLink")

  @@index([lastName, firstName])
  @@index([phone])
  @@index([branchId])
  @@index([dateOfBirth])
  @@index([status])
  @@index([joinedAt])
}

model Household {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   HouseholdMember[]
}

enum HouseholdRelation {
  Head
  Spouse
  Child
  Dependent
  Other
}

model HouseholdMember {
  id          String             @id @default(cuid())
  householdId String
  memberId    String
  relation    HouseholdRelation  @default(Other)
  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member      Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([householdId, memberId])
}

model MemberStatusHistory {
  id            String        @id @default(cuid())
  memberId      String
  fromStatus    MemberStatus?
  toStatus      MemberStatus
  fromBranchId  String?
  toBranchId    String?
  reason        String?
  changedById   String?
  createdAt     DateTime      @default(now())
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fromBranch    Branch?       @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch      Branch?       @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: SetNull)
  changedBy     User?         @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
}

enum DuplicateReviewStatus {
  Pending
  ConfirmedDuplicate
  Dismissed
}

model DuplicateCandidate {
  id         String                @id @default(cuid())
  memberAId  String
  memberBId  String
  score      Float
  reasons    String[]
  status     DuplicateReviewStatus @default(Pending)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  memberA    Member                @relation("DuplicateA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberB    Member                @relation("DuplicateB", fields: [memberBId], references: [id], onDelete: Cascade)

  @@unique([memberAId, memberBId])
  @@index([status])
}

// ─── Finance (HQ-only; route/API gated) ──────────────────────────────────────

enum ObligationKind {
  Pledge
  Tithe
  Dues
  SpecialProject
  Thanksgiving
}

model ObligationType {
  id          String         @id @default(cuid())
  kind        ObligationKind
  name        String
  code        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  obligations Obligation[]
}

model Obligation {
  id                   String              @id @default(cuid())
  memberId             String
  obligationTypeId     String
  fellowshipMinistryId String?
  periodStart          DateTime
  periodEnd            DateTime?
  expectedAmount       Decimal             @db.Decimal(12, 2)
  currency             String              @default("GHS")
  instalmentCount      Int?
  projectTargetAmount  Decimal?            @db.Decimal(12, 2)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  member               Member              @relation(fields: [memberId], references: [id])
  obligationType       ObligationType      @relation(fields: [obligationTypeId], references: [id])
  fellowshipMinistry   FellowshipMinistry? @relation(fields: [fellowshipMinistryId], references: [id], onDelete: SetNull)
  payments             Payment[]

  @@index([memberId])
  @@index([obligationTypeId, periodStart])
}

model CollectionBatch {
  id             String    @id @default(cuid())
  batchDate      DateTime
  label          String
  countedTotal   Decimal   @db.Decimal(12, 2)
  systemTotal    Decimal   @default(0) @db.Decimal(12, 2)
  varianceAmount Decimal   @default(0) @db.Decimal(12, 2)
  hasVariance    Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]

  @@index([batchDate])
}

model Payment {
  id            String           @id @default(cuid())
  obligationId  String
  batchId       String?
  amount        Decimal          @db.Decimal(12, 2)
  paidAt        DateTime
  method        String?
  reference     String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  obligation    Obligation       @relation(fields: [obligationId], references: [id])
  batch         CollectionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([obligationId])
  @@index([batchId])
  @@index([paidAt])
}

// ─── Reporting config (skeleton for Reporting workstream) ────────────────────

model ReportTemplate {
  id          String           @id @default(cuid())
  name        String
  description String?
  layout      Json
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  schedules   ReportSchedule[]
}

model ReportSchedule {
  id              String         @id @default(cuid())
  reportTemplateId String
  cronExpression  String
  distributionList String[]
  isActive        Boolean        @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  reportTemplate  ReportTemplate @relation(fields: [reportTemplateId], references: [id], onDelete: Cascade)
}

/// Named custom report definitions (MVP builder — members or contributions dataset).
model SavedReport {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// members | contributions
  dataset     String
  filters     Json     @default("{}")
  columns     Json
  /// Role that owns / may open this saved report (church-native RBAC).
  roleScope   String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roleScope, dataset])
  @@index([createdById])
}

// ─── Admin domains / dropdowns (skeleton) ────────────────────────────────────

model DomainList {
  id          String            @id @default(cuid())
  key         String            @unique
  label       String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  values      DomainListValue[]
}

model DomainListValue {
  id           String     @id @default(cuid())
  domainListId String
  value        String
  label        String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  parentValue  String?
  domainList   DomainList @relation(fields: [domainListId], references: [id], onDelete: Cascade)

  @@unique([domainListId, value])
}

// ─── Phase D — tags, milestones, visitor follow-up ───────────────────────────

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  members   MemberTag[]
}

model MemberTag {
  id        String   @id @default(cuid())
  memberId  String
  tagId     String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([memberId, tagId])
  @@index([tagId])
}

enum MilestoneKind {
  Birthday
  WeddingAnniversary
  Baptism
  Confirmation
  Dedication
  Other
}

model MemberMilestone {
  id          String        @id @default(cuid())
  memberId    String
  kind        MilestoneKind
  occurredOn  DateTime
  title       String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, occurredOn])
  @@index([kind, occurredOn])
}

enum FollowUpStatus {
  Open
  InProgress
  Completed
  Cancelled
}

model VisitorFollowUp {
  id           String         @id @default(cuid())
  memberId     String
  status       FollowUpStatus @default(Open)
  firstVisitOn DateTime?
  notes        String?
  nextActionOn DateTime?
  assignedToId String?
  createdById  String?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, nextActionOn])
  @@index([memberId])
}

// ─── Phase D — attendance (manual MVP) ───────────────────────────────────────

enum AttendanceKind {
  Service
  Cell
}

model AttendanceSession {
  id           String         @id @default(cuid())
  kind         AttendanceKind
  label        String
  heldAt       DateTime
  branchId     String
  cellId       String?
  headcount    Int?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cell         Cell?          @relation(fields: [cellId], references: [id], onDelete: SetNull)
  records      AttendanceRecord[]

  @@index([branchId, heldAt])
  @@index([cellId, heldAt])
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  sessionId  String
  memberId   String
  present    Boolean           @default(true)
  markedById String?
  notes      String?
  createdAt  DateTime          @default(now())
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member     Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  markedBy   User?             @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, memberId])
  @@index([memberId])
}

// ─── Phase D — pastoral care (restricted) ────────────────────────────────────

enum PastoralNoteKind {
  Prayer
  Visitation
  Counselling
  Wedding
  Funeral
  Dedication
  Other
}

model PastoralCareNote {
  id         String           @id @default(cuid())
  memberId   String?
  kind       PastoralNoteKind
  title      String
  body       String
  occurredOn DateTime         @default(now())
  isPrivate  Boolean          @default(true)
  authorId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  member     Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  author     User?            @relation("PastoralAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([kind, occurredOn])
  @@index([memberId])
}

// ─── Phase D — events calendar MVP ───────────────────────────────────────────

model ChurchEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  branchId    String?
  capacity    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([startsAt])
  @@index([branchId])
}

model EventRegistration {
  id        String      @id @default(cuid())
  eventId   String
  name      String
  phone     String?
  email     String?
  memberId  String?
  notes     String?
  createdAt DateTime    @default(now())
  event     ChurchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ─── Phase D — communication channel stubs ───────────────────────────────────

enum CommChannelKind {
  Email
  Sms
  WhatsApp
  Push
}

model CommunicationChannel {
  id          String          @id @default(cuid())
  kind        CommChannelKind @unique
  label       String
  isEnabled   Boolean         @default(false)
  /// Provider config (API keys must stay in env — store non-secret settings only).
  configJson  Json            @default("{}")
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum MessageTemplateKind {
  Birthday
  Welcome
  Receipt
  BoardReport
  Custom
}

model MessageTemplate {
  id        String              @id @default(cuid())
  kind      MessageTemplateKind
  name      String
  subject   String?
  body      String
  channel   CommChannelKind     @default(Email)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([kind])
}

/// Outbound stub log — records “would send” until live providers are wired.
model MessageOutbox {
  id          String          @id @default(cuid())
  channel     CommChannelKind
  templateKind MessageTemplateKind?
  toAddress   String
  subject     String?
  body        String
  status      String          @default("stubbed")
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([createdAt])
  @@index([status])
}
