{
  "name": "ltjbm-cdms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:finance && npm run test:reporting && npm run test:gl && npm run test:security",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:finance": "tsx --test src/lib/finance/*.test.ts",
    "test:reporting": "tsx --test src/lib/reporting/*.test.ts",
    "test:gl": "tsx --test src/lib/gl/*.test.ts",
    "test:smoke": "tsx scripts/smoke-section8.ts",
    "smoke:finance": "tsx scripts/smoke-finance.ts",
    "test:security": "tsx --test src/lib/roles.test.ts src/lib/volunteers/conflicts.test.ts",
    "report:monthly": "tsx scripts/send-board-report.ts",
    "comms:automations": "tsx scripts/run-comms-automations.ts",
    "backup:db": "bash scripts/backup-db.sh",
    "restore:db": "bash scripts/restore-db.sh",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
