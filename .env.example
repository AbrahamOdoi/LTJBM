# Copy to .env and adjust. Never commit .env.
# Generate secrets: openssl rand -base64 32

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=cdms
POSTGRES_PASSWORD=cdms
POSTGRES_DB=cdms
# Host loopback only (compose binds 127.0.0.1)
POSTGRES_HOST_PORT=5432

# Prisma / app connection (host machine → published Postgres port)
DATABASE_URL="postgresql://cdms:cdms@localhost:5432/cdms?schema=public"
# Inside the Compose `app` service, compose overrides DATABASE_URL to use host `postgres`.

# --- Auth.js ---
AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of the app (staging: https://your-host.example)
AUTH_URL="http://localhost:3000"

# --- App container (staging profile) ---
APP_HOST_PORT=3000
NODE_ENV=development

# --- Seed (optional) ---
SEED_PASSWORD="ChangeMe123!"

# --- Reporting — monthly Board email (demo-friendly) ---
# file (default): write HTML under REPORT_EMAIL_DIR
# console: print subject + HTML snippet
REPORT_EMAIL_MODE="file"
REPORT_EMAIL_DIR="./tmp/board-reports"
# Optional bearer token for POST /api/reports/schedules/run (cron / staging job)
REPORT_CRON_SECRET="replace-with-cron-secret"

# --- Backups (scripts/backup-db.sh) ---
# BACKUP_DIR=./backups
# COMPOSE_SERVICE=postgres

# --- Photos ---
# Demo stores member photos under public/uploads/members (Compose volume cdms_uploads in staging profile).
# Production should move to S3-compatible object storage (see build plan).
