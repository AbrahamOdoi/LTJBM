# Copy to .env and adjust as needed.

# Local Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://cdms:cdms@localhost:5432/cdms?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional explicit URL for Auth.js in some hosts
AUTH_URL="http://localhost:3000"

# Seed demo passwords (optional overrides)
SEED_PASSWORD="ChangeMe123!"

# Reporting — monthly Board email (demo-friendly)
# file (default): write HTML under REPORT_EMAIL_DIR
# console: print subject + HTML snippet
REPORT_EMAIL_MODE="file"
REPORT_EMAIL_DIR="./tmp/board-reports"
# Optional bearer token for POST /api/reports/schedules/run (cron)
REPORT_CRON_SECRET="replace-with-cron-secret"
