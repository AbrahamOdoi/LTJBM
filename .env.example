# Copy to .env and adjust. Never commit .env.
# Generate secrets: openssl rand -base64 32

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=cdms
POSTGRES_PASSWORD=cdms
POSTGRES_DB=cdms
# Host loopback only (compose binds 127.0.0.1)
POSTGRES_HOST_PORT=5432

# Prisma / app connection (host machine → published Postgres port)
DATABASE_URL="postgresql://cdms:cdms@localhost:5432/cdms?schema=public"
# Inside the Compose `app` service, compose overrides DATABASE_URL to use host `postgres`.

# --- Auth.js ---
# REQUIRED in every environment. Never commit the real value.
AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of the app (staging: https://your-host.example). Also used for same-origin checks.
AUTH_URL="http://localhost:3000"

# --- App container (staging profile) ---
APP_HOST_PORT=3000
NODE_ENV=development

# --- Seed (optional) ---
# Default ChangeMe123! is LOCAL DEMO ONLY. Seed refuses that default when NODE_ENV=production.
SEED_PASSWORD="ChangeMe123!"

# --- Reporting — monthly Board email (demo-friendly) ---
# file (default): write HTML under REPORT_EMAIL_DIR
# console: print subject + HTML snippet
# smtp: live send via SMTP_* (falls back to file if credentials absent)
REPORT_EMAIL_MODE="file"
REPORT_EMAIL_DIR="./tmp/board-reports"
# Bearer token for POST /api/reports/schedules/run and /api/comms/run (cron / staging job).
# Must be ≥16 characters and not a placeholder like "replace-with-cron-secret".
REPORT_CRON_SECRET="replace-with-cron-secret"

# --- SMTP (live email for Board schedules + member outbox) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Living Testimonies <noreply@example.com>"

# --- SMS (Twilio default, or SMS_PROVIDER=africastalking) ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_FROM=

# --- Online giving (demo mode when keys absent; always posts to HQ ledger) ---
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# MOMO_API_KEY=
# MOMO_SUBSCRIPTION_KEY=
# MOMO_TARGET_ENV=sandbox
# MOMO_API_BASE=https://sandbox.momodeveloper.mtn.com/collection/v1_0

# --- Backups (scripts/backup-db.sh + backup-scheduled.sh) ---
# BACKUP_DIR=./backups
# COMPOSE_SERVICE=postgres
# BACKUP_SCHEDULE_ENABLED=true
# BACKUP_CRON="0 2 * * *"
# BACKUP_RETENTION_DAYS=14
# BACKUP_WITH_UPLOADS=true
# BACKUP_WITH_SQL=false

# --- Photos (S3-compatible object storage; local disk fallback when unset) ---
# When set, uploads go to the bucket under members/{photoKey}.
# Serving always uses /api/members/photos/{key} with branch-scoped ACL.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=ltjbm-member-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Local fallback directory (when S3_* unset): storage/uploads/members

